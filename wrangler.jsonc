{
  "name": "elc-kozhikode",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "triggers": { "crons": ["*/5 * * * *"] },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash"
  },
  "durable_objects": { "bindings": [{ "name": "PORTAL", "class_name": "Portal" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Portal"] }]
}
